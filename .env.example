NODE_ENV=production
# Use a dedicated localhost port so this app can coexist with other instances.
PORT=3103
TRUST_PROXY=1

# Independent MySQL server. Prefer its private network address.
DB_HOST=10.0.0.20
DB_PORT=3306
DB_NAME=surprise_draw
DB_USER=surprise_app
DB_PASSWORD=replace-with-a-long-password
DB_POOL_SIZE=10
# Set true only when the independent MySQL endpoint is configured for TLS.
DB_SSL=false

# Generate with: openssl rand -hex 32
TOKEN_SECRET=replace-with-at-least-32-random-characters
ADMIN_COOKIE_HOURS=12

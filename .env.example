NODE_ENV=production
# Use a dedicated localhost port so this app can coexist with other instances.
PORT=3103
TRUST_PROXY=1

# Aliyun RDS MySQL endpoint. The password belongs only in the server-side .env.
DB_HOST=rm-2zekuid15ms1s85iygo.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_NAME=manghe
DB_USER=manghe
DB_PASSWORD=replace-with-a-long-password
DB_POOL_SIZE=10
# Set true only after RDS SSL is enabled and its CA trust is configured.
DB_SSL=false

# Generate with: openssl rand -hex 32
TOKEN_SECRET=replace-with-at-least-32-random-characters
ADMIN_COOKIE_HOURS=12
